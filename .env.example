# Firebase Authentication only (admin login). No Firestore / Realtime Database / Storage.
# This site is static HTML (not Vite). These VITE_ names are still read at Vercel build
# by scripts/write-frontend-config.js and written into frontend/js/kalongo-config.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — images/videos use the unsigned preset (new files only, no overwrite).
CLOUDINARY_CLOUD_NAME=dae3rpnmg
CLOUDINARY_UPLOAD_PRESET=kalongo_unsigned
CLOUDINARY_CONTENT_PUBLIC_ID=kalongo/site-content

# Cloudinary catalog write — Vercel /api/publish only. Never put these in frontend JS.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
