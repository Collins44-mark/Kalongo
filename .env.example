# Firebase Authentication only (admin login). No Firestore / Realtime Database / Storage.
# This site is static HTML (not Vite). These VITE_ names are still read at Vercel build
# by scripts/write-frontend-config.js and written into frontend/js/kalongo-config.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — existing images/videos. Admin publish uses the same unsigned upload preset
# as a JSON file (not a database). In Cloudinary: Settings → Upload → unsigned preset,
# allow overwrite, and allow raw file uploads.
CLOUDINARY_CLOUD_NAME=dae3rpnmg
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_CONTENT_PUBLIC_ID=kalongo/site-content
